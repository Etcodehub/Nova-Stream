{
  "name": "novastream",
  "version": "1.0.0",
  "description": "Production-grade browser streaming architecture with multi-source failover, 0ms IndexedDB caching, monotonic delta sync, and CORS edge gateway",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "gateway": "node --loader ts-node/esm gateway/proxy.ts",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "streaming",
    "hls",
    "dash",
    "clearkey",
    "failover",
    "indexeddb",
    "delta-sync",
    "cors-proxy"
  ],
  "author": "NovaStream Engineering",
  "license": "MIT",
  "dependencies": {
    "hls.js": "^1.5.17",
    "idb": "^8.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
